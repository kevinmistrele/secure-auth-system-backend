# Server
PORT=3001
FRONTEND_URL=http://localhost:5173

# Database — two roles on purpose (see docs/architecture/tenancy-and-rls.md):
#  - DATABASE_URL: privileged role; migrations + the auth plane (login/refresh/invite-accept)
#  - APP_DATABASE_URL: RLS-enforced role (app_user); every tenant-scoped query
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/secure_auth?schema=public
APP_DATABASE_URL=postgresql://app_user:app_user@localhost:5432/secure_auth?schema=public

# Auth
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Mail (optional — invitation/reset links are logged to the console when unset)
SMTP_USER=
SMTP_PASS=
